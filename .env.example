# ─────────────────────────────────────────────────────────────────────────────
# NUVIXO – Environment Variables
# Copy this file to .env.local for local development
# Set all variables in Vercel / your server for production
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# Local: postgresql://USER:PASSWORD@localhost:5432/nuvixo
# Neon / Supabase / Railway: get from dashboard
DATABASE_URL=

# ── Google OAuth ─────────────────────────────────────────────────────────────
# Create at https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# ── Cloudinary ───────────────────────────────────────────────────────────────
# Create free account at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Razorpay ─────────────────────────────────────────────────────────────────
# Get from https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Public key exposed to client
NEXT_PUBLIC_RAZORPAY_KEY=

# ── Email / SMTP ─────────────────────────────────────────────────────────────
# Use Gmail App Password, SendGrid, Mailgun, Resend, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Nuvixo <noreply@nuvixo.com>"

# ── Analytics ────────────────────────────────────────────────────────────────
# Google Analytics 4 Measurement ID (G-XXXXXXXXXX)
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX
# Microsoft Clarity Project ID
NEXT_PUBLIC_CLARITY_ID=

# ── Meta Pixel (optional) ────────────────────────────────────────────────────
NEXT_PUBLIC_META_PIXEL_ID=

# ── Redis (optional, for advanced rate limiting / caching) ───────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=redis_secret

# ── Docker Compose (local only) ──────────────────────────────────────────────
POSTGRES_USER=nuvixo
POSTGRES_PASSWORD=nuvixo_secret
POSTGRES_DB=nuvixo
